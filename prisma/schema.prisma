generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        String   @id              // Firebase uid — lo asigna Firebase, no la BD
  name      String
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  avatarUrl String?
  rentals   rentals[]
}

model Hardware {
  id        String         @id @default(uuid())
  model     String
  specs     String
  category  Category
  dailyRate Float
  status    Status         @default(AVAILABLE)
  createdAt DateTime       @default(now())
  rentals   rentals[]
}

model rentals {
  id         String    @id @default(uuid())
  userId     String
  hardwareId String
  startDate  DateTime  @default(now())
  endDate    DateTime?
  totalPrice Float?
  hardware   Hardware  @relation(fields: [hardwareId], references: [id])
  user       users     @relation(fields: [userId], references: [id])
  status     Status
}

enum Role {
  USER
  ADMIN
}

enum Category {
  LAPTOP
  TABLET
  PERIPHERAL
}

enum Status {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETURNED
}
